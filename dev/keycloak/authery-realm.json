{
  "realm": "authery",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "authery-example",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "authery-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["*"]
    }
  ],
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "email": "testuser@example.com",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "testpass",
          "temporary": false
        }
      ]
    }
  ]
}
